HOST=127.0.0.1
PORT=3010
# 对外部署必须配置；所有 /api/ 路由使用 Authorization: Bearer <API_KEY>
API_KEY=
RATE_LIMIT_PER_MINUTE=30
UPSTREAM_TIMEOUT_MS=20000
# 仅由服务部署者配置，客户端不能提交 Cookie。请勿提交真实凭据。
TYC_COOKIE=
AQC_COOKIE=
# 企查查默认使用 Cookie + HTTP；不会自动启动或切换到浏览器。
QCC_MODE=http
QCC_COOKIE=
# 可选：连接用户已经登录企查查的本机 Chrome，不自动登录或导航。
# 使用此模式时显式设置 QCC_MODE=browser。
# 容器里的 127.0.0.1 指向容器自身；浏览器模式建议本机运行。
QCC_CDP_URL=
