
HOST=127.0.0.1
PORT=3010

# 对外部署必须配置；所有 /api/ 路由使用 Authorization: Bearer <API_KEY>
API_KEY=
RATE_LIMIT_PER_MINUTE=30
UPSTREAM_TIMEOUT_MS=20000

# 仅由服务部署者配置，客户端不能提交 Cookie。请勿提交真实凭据。
# 企查查登录会话
QCC_COOKIE=your-qcc-cookie
# 爱企查登录会话
AQC_COOKIE=your-aiqicha-cookie
# 天眼查按需配置；本次基础搜索和详情已验证匿名可用
TYC_COOKIE=
# 水滴信用按需配置；基础搜索和详情默认支持匿名使用
SHUIDI_COOKIE=
# 启信宝按需配置；企业详情默认支持匿名使用，搜索和高频调用建议配置
QXB_COOKIE=
